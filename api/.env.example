# URL-encode special characters in the password (e.g. @ becomes %40).
DATABASE_URL="postgresql://newcomer:YOUR_PASSWORD@localhost:5432/nb_newcomer"
PORT=3000
CORS_ORIGIN="http://localhost:5173"
LOG_LEVEL=info
# Secret for the moderation page (/admin/suggestions), at least 24 characters. Leave unset to turn moderation off.
ADMIN_TOKEN=
# Chat assistant (Claude on Amazon Bedrock). Without AWS_REGION, /api/chat answers 503 and the rest of the site still works.
AWS_REGION=us-east-1
# Inference profile ID: the Bedrock catalog model ID with a "global." (or "us.") prefix.
BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
# Production only (set by template.yaml, leave unset locally): secret CloudFront sends as X-Origin-Verify.
# When set, the API refuses requests without it and rate-limits by the visitor IP CloudFront passes on.
# ORIGIN_SECRET=
# AWS credentials: use an AWS profile or SSO login (AWS_PROFILE=...) or, on AWS, an IAM role.
# Only for local testing, access keys also work: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.
